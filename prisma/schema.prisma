generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventClassificationStatus {
  pending
  classified
  fallback
  retry
}

model Event {
  id                   String                    @id
  source               String
  sourceFingerprint    String                    @unique @map("source_fingerprint")
  sourceUrl            String                    @map("source_url")
  title                String
  description          String
  clubName             String                    @map("club_name")
  startTime            DateTime                  @map("start_time") @db.Timestamptz(6)
  endTime              DateTime                  @map("end_time") @db.Timestamptz(6)
  locationName         String                    @map("location_name")
  buildingCode         String?                   @map("building_code")
  sourceTags           String[]                  @default([]) @map("source_tags")
  sourceImageUrl       String?                   @map("source_image_url")
  imageContentHash     String?                   @map("image_content_hash")
  supersededById       String?                   @map("superseded_by_id")
  endTimeEstimated     Boolean                   @default(false) @map("end_time_estimated")
  imageUrl             String?                   @map("image_url")
  isFreeFood           Boolean                   @default(false) @map("is_free_food")
  contentHash          String                    @map("content_hash")
  classificationStatus EventClassificationStatus @default(pending) @map("classification_status")
  classification       EventClassification?
  geocode              EventGeocode?
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([startTime], map: "events_start_time_idx")
  @@index([classificationStatus], map: "events_classification_status_idx")
  @@map("events")
}

model EventGeocode {
  eventId      String   @id @map("event_id")
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  locationKey  String   @map("location_key")
  query        String
  status       String
  latitude     Float?
  longitude    Float?
  displayName  String?  @map("display_name")
  source       String
  checkedAt    DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  retryAfter   DateTime? @map("retry_after") @db.Timestamptz(6)

  @@index([query, source], map: "event_geocodes_query_source_idx")
  @@index([source, checkedAt], map: "event_geocodes_source_checked_at_idx")
  @@map("event_geocodes")
}

model EventClassification {
  eventId       String   @id @map("event_id")
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  promptVersion String   @map("prompt_version")
  model         String
  primaryTag    String   @map("primary_tag")
  tags          String[] @default([])
  vibes         String[] @default([])
  audiences     String[] @default([])
  format        String
  confidence    Float
  rationale     String
  classifiedAt  DateTime @default(now()) @map("classified_at") @db.Timestamptz(6)

  @@index([primaryTag], map: "event_classifications_primary_tag_idx")
  @@map("event_classifications")
}

model Interaction {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String?  @map("user_id") @db.Uuid
  anonymousSessionId String?  @map("anonymous_session_id")
  eventId            String   @map("event_id")
  action             String
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "interactions_user_id_idx")
  @@index([eventId], map: "interactions_event_id_idx")
  @@index([action], map: "interactions_action_idx")
  @@index([createdAt(sort: Desc)], map: "interactions_created_at_idx")
  @@map("interactions")
}

// Durable work records; only validated events enter the public Event table.
model SocialPost {
  id                String   @id
  shortcode         String
  accountHandle     String   @map("account_handle")
  accountName       String   @map("account_name")
  sourceUrl         String   @map("source_url")
  caption           String
  postedAt          DateTime? @map("posted_at") @db.Timestamptz(6)
  incompleteMedia   Boolean  @default(false) @map("incomplete_media")
  mediaUrls         String[] @default([]) @map("media_urls")
  contentHash       String   @map("content_hash")
  status            String   @default("pending")
  extraction        Json?
  extractionModel   String? @map("extraction_model")
  extractionVersion String?  @map("extraction_version")
  attempts          Int      @default(0)
  nextRetryAt       DateTime? @map("next_retry_at") @db.Timestamptz(6)
  leaseToken        String?  @map("lease_token")
  leaseUntil        DateTime? @map("lease_until") @db.Timestamptz(6)
  lastError         String?  @map("last_error")
  inputTokens       Int      @default(0) @map("input_tokens")
  outputTokens      Int      @default(0) @map("output_tokens")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  media             SocialMedia[]
  events            SocialEventMapping[]

  @@unique([accountHandle, shortcode])
  @@index([status, nextRetryAt, leaseUntil])
  @@map("social_posts")
}

model SocialMedia {
  id          String @id
  postId      String @map("post_id")
  post        SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  identity    String
  sourceUrl   String @map("source_url")
  contentHash String @map("content_hash")
  storagePath String? @map("storage_path")
  publicUrl   String? @map("public_url")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([postId, identity])
  @@map("social_media")
}

model SocialEventMapping {
  id          String @id
  postId      String @map("post_id")
  post        SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  slot        Int
  titleKey    String @map("title_key")
  localDate   String @map("local_date")
  candidate   Json
  eventId     String? @map("event_id")
  imageIndex  Int? @map("image_index")
  imagePending Boolean @default(false) @map("image_pending")

  @@unique([postId, slot])
  @@index([eventId])
  @@map("social_event_mappings")
}

// Private checkpoints and conservative charge reservations for paid collection.
model SocialCollectionState {
  accountHandle String @id @map("account_handle")
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastReviewAt DateTime? @map("last_review_at") @db.Timestamptz(6)
  nextCheckAt DateTime @default(now()) @map("next_check_at") @db.Timestamptz(6)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  resultsLimit Int @default(12) @map("results_limit")
  @@map("social_collection_state")
}

model ApifyCollectionRun {
  id String @id
  workflowId String @map("workflow_id")
  accountHandle String @map("account_handle")
  providerRunId String? @unique @map("provider_run_id")
  reservedMicros Int @map("reserved_micros")
  resultsLimit Int @default(12) @map("results_limit")
  chargedMicros Int? @map("charged_micros")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([createdAt])
  @@index([workflowId])
  @@map("apify_collection_runs")
}
